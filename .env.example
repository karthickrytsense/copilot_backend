OPENAI_API_KEY=your_openai_api_key_here

# Google Sheets (lead storage)
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_CREDENTIALS={"type":"service_account",...}  # use this on Vercel instead of file

# Google Calendar (meeting booking)
OWNER_EMAIL=your_email@gmail.com
OWNER_CALENDAR_ID=your_email@gmail.com
OWNER_TIMEZONE=Asia/Kolkata
MEETING_DURATION_MINUTES=30

# Google OAuth2 Desktop (run scripts/google_auth_setup.py once to get refresh token)
GOOGLE_OAUTH_CLIENT_ID=your_desktop_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_desktop_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_refresh_token

# Google OAuth2 Web (used for /auth/google endpoint)
GOOGLE_WEB_CLIENT_ID=your_web_oauth_client_id
GOOGLE_WEB_CLIENT_SECRET=your_web_oauth_client_secret
